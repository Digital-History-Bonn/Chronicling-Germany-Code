# Settings for script/pipeline.sh on the Bonn HPC cluster Marvin: one A40 GPU and
# 8 CPU cores per job, models one level above the checkout.
# Use: PIPELINE_CONFIG=script/configs/marvin_a40.env script/pipeline.sh DATA_DIR ENV_NAME
#
# These are the fastest settings measured for 100 test pages of the
# Chronicling Germany dataset (Slurm jobs 29181911 and 29184057, Nov 2026):
# whole pipeline 301 s instead of 1132 s, line-search CER 4.3 % instead of 4.7 %.
# Baselines with -p 8 rely on the GPU cache release and OOM retry of the baseline stage;
# OCR -p 4 stays below the A40's 48 GB (-p 8 needed 11 OOM retries).
# Layout scale 0.25 is what the newspaper benchmark reports.
MODEL_DIR="../models/Chronicling-Germany-Dataset-main-models/models"
LAYOUT_PARAMS="-th 0.6 -a dh_segment -s 0.25 -e -bt 100 -t 32"
BASELINE_ARGS="-t 1 -p 8"
BASELINE_THREADS=1
OCR_ARGS="-t 1 -p 4 -b 32 -w 0"
OCR_THREADS=1
